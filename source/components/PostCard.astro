---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { CATEGORY_CONFIG, type BlogCategory } from '../lib/categories'

interface Props {
  title: string
  description: string
  pubDate: Date
  category: BlogCategory
  slug: string
  heroImage?: ImageMetadata
  readingTime: string
  featured?: boolean
  priority?: boolean
}

const { title, description, pubDate, category, slug, heroImage, readingTime, featured = false, priority = false } = Astro.props

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
})

const catConfig = CATEGORY_CONFIG[category]
---

<article class={`mona-card${featured ? ' mona-card--featured' : ''}`}>
  <a href={`/${slug}/`} class="mona-card-img-link" tabindex="-1" aria-hidden="true">
    <div class="mona-card-img" style={!heroImage ? `background: ${catConfig.gradient}` : ''}>
      {heroImage
        ? <Image
            src={heroImage}
            alt={title}
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : undefined}
            widths={[320, 400, 500, 600, 720, 800]}
            sizes={featured
              ? "(max-width: 640px) calc(100vw - 48px), 650px"
              : "(max-width: 640px) calc(100vw - 48px), 325px"
            }
            width={800}
            height={310}
            quality={30}
            format="avif"
            class=""
          />
        : <div class="cat-icon" set:html={catConfig.icon} />
      }
    </div>
  </a>
  <div class="mona-card-body">
    <span class="mona-badge">{category}</span>
    <h3 class="mona-title">
      <a href={`/${slug}/`}>{title}</a>
    </h3>
    <p class="mona-desc">{description}</p>
    <div class="mona-footer">
      <span class="mona-meta">{formattedDate} · {readingTime}</span>

    </div>
  </div>
</article>

<style>
.mona-card {
  border:1px solid #44445e;
  border-radius:12px;
  overflow:hidden;
  min-width:0;
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  transition: background 0.15s, box-shadow 0.2s ease;
}
.mona-card:hover { background: #1A1A2E; }

@media (hover: hover) {
  .mona-card:hover {
    box-shadow: inset 0 0 0 1px #A78BFA40;
  }
}

.mona-card--featured .mona-card-img { height: 160px; }
.mona-card--featured .mona-title a { font-size: 18px; }

.mona-card-img-link { display: block; }
.mona-card-img {
  width: 100%;
  height: 140px;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* :global needed — <Image> renders <img> outside Astro's scope boundary */
.mona-card-img :global(img) {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.cat-icon {
  width: 56px;
  height: 56px;
  opacity: 0.85;
}
.cat-icon svg {
  width: 100%;
  height: 100%;
}
.mona-card--featured .cat-icon {
  width: 72px;
  height: 72px;
}

.mona-card-body {
  padding: 16px 18px 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.mona-badge {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #A78BFA;
  margin-bottom: 8px;
  display: block;
}

.mona-title {
  font-size: 20px;
  font-weight: 700;
  line-height: 1.4;
  color: #E8E8F0;
  margin-bottom: 8px;
  flex: 1;
}
.mona-title a {
  color: inherit;
  text-decoration: none;
  transition: color 0.15s;
}
.mona-title a:hover { color: #A78BFA; }

.mona-desc {
  font-size: 16px;
  color: var(--color-muted);
  line-height: 1.55;
  margin-bottom: 14px;
}

.mona-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid #2A2A40;
  gap: 8px;
}

.mona-meta {
  font-size: 11px;
  color: var(--color-muted);
  white-space: normal;
}

.mona-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.mona-share { display: flex; gap: 6px; }
.share-icon {
  width: 24px; height: 24px;
  border-radius: 4px;
  border: 1px solid #2A2A40;
  display: flex; align-items: center; justify-content: center;
  color: #505070;
  text-decoration: none;
  transition: border-color 0.15s, color 0.15s;
}
.share-icon:hover { border-color: #6D28D9; color: #A78BFA; }

.mona-read {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: #A78BFA;
  text-decoration: none;
  white-space: normal;
  transition: color 0.15s;
}
.mona-read:hover { color: #E8E8F0; }
</style>
