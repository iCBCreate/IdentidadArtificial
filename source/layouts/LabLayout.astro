---
import BaseLayout from './BaseLayout.astro'
import { SITE } from '../config'

interface Props {
  title: string
  description: string
  image?: string
  jsonLd?: object | object[]
  eyebrow?: string
  heading: string
  subtitle: string
}

const { title, description, image, jsonLd, eyebrow = 'Laboratorio', heading, subtitle } = Astro.props

const isIndex = Astro.url.pathname.replace(/\/$/, '') === '/laboratorio'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: isIndex
    ? [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Laboratorio' },
      ]
    : [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Laboratorio', item: `${SITE.url}/laboratorio/` },
        { '@type': 'ListItem', position: 3, name: heading },
      ],
}

const allJsonLd = [breadcrumbSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])]
---

<BaseLayout title={title} description={description} image={image} jsonLd={allJsonLd}>
  <section class="page-hero">
    <nav class="lab-breadcrumb" aria-label="Ruta de navegación">
      <a href="/" aria-label="Inicio">⌂</a>
      <span class="sep">›</span>
      {isIndex
        ? <span class="current">Laboratorio</span>
        : <>
            <a href="/laboratorio/">Laboratorio</a>
            <span class="sep">›</span>
            <span class="current">{heading}</span>
          </>
      }
    </nav>
    <p class="page-eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="page-subtitle">{subtitle}</p>
    <p class="lab-disclaimer">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      El texto se procesa en tu navegador. Algunas herramientas descargan recursos externos.
    </p>
  </section>

  <div class="page-body">
    <slot />
  </div>
</BaseLayout>

<style>
.page-hero {
  max-width: 1152px;
  margin: 0 auto;
  padding: 40px 32px 26px;
}

.lab-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #C8C8E0;
  margin-bottom: 24px;
}
.lab-breadcrumb a { color: #C8C8E0; text-decoration: none; transition: color 0.15s; }
.lab-breadcrumb a:hover { color: #A78BFA; }
.lab-breadcrumb .sep { color: #3A3A54; }
.lab-breadcrumb .current { color: #E8E8F0; }

.page-eyebrow {
  color: #A78BFA;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  margin: 0 0 10px;
}

h1 {
  color: #E8E8F0;
  font-size: clamp(30px, 5vw, 48px);
  font-weight: 900;
  line-height: 1.15;
  margin-top: 10px;
}

.page-subtitle {
  display: block;
  max-width: 680px;
  color: #C8C8E0;
  font-size: 16px;
  line-height: 1.7;
  margin-top: 16px;
}

.lab-disclaimer {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 18px;
  padding: 6px 12px;
  border: 1px solid #2A2A40;
  border-radius: 999px;
  color: #34D399;
  font-size: 12px;
  font-weight: 600;
}

.page-body {
  max-width: 1152px;
  margin: 0 auto;
  padding: 16px 32px 48px;
}

.page-body :global(button), .page-body :global(input:not([type="checkbox"])), .page-body :global(select) { min-height: 44px; }
.page-body :global(:focus-visible) { outline: 3px solid #A78BFA; outline-offset: 3px; }
.page-body :global([hidden]) { display: none !important; }
.page-body :global(p), .page-body :global(li), .page-body :global(dd) { font-size: 17px; line-height: 1.7; }
.page-body :global(textarea) { font-size: 17px; }
.page-body :global(.lab-actions) { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0; }
.page-body :global(button:disabled) { opacity: .65; cursor: not-allowed; }
.lab-disclaimer { border-radius: 8px; }
@media(max-width: 640px) { .page-hero { padding: 32px 20px 16px; } .page-body { padding: 16px 20px 48px; } }
@media(prefers-reduced-motion: reduce) { .page-body :global(*) { animation: none !important; transition: none !important; } }
</style>
