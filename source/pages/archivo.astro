---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'
import ArchiveSearch from '../components/ArchiveSearch.astro'
import { categoryToSlug } from '../lib/categories'
import { SITE } from '../config'
import {
  ARCHIVE_PAGE_SIZE,
  calcReadingTime,
  getPageItems,
  getPostCategories,
  getSortedPosts,
  getTotalPages,
} from '../lib/posts'

const allPosts = await getSortedPosts()
const totalPages = getTotalPages(allPosts.length, ARCHIVE_PAGE_SIZE)
const posts = getPageItems(allPosts, 1, ARCHIVE_PAGE_SIZE)
const categories = getPostCategories(allPosts)

const archiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Artículos de IA en español — Identidad Artificial',
  description: 'Todos los artículos de Identidad Artificial sobre IA generativa, LLMs, modelos y agentes en español. Análisis técnicos con revisión experta.',
  url: `${SITE.url}/archivo/`,
  inLanguage: 'es',
  isAccessibleForFree: true,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/sobre/`,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Artículos sobre inteligencia artificial',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: `${SITE.url}/${post.id}/`,
    })),
  },
}
---

<BaseLayout
  title="Artículos de IA en español"
  description="Todos los artículos de Identidad Artificial sobre IA generativa, LLMs, modelos y agentes en español. Análisis técnicos con revisión experta."
  image="/og/archivo.png"
  jsonLd={archiveSchema}
>
  <section class="page-shell"><nav aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-current="page">Artículos</span></nav><header class="page-heading"><p class="eyebrow">Archivo</p><h1>Artículos de IA</h1><p>Encuentra explicaciones, análisis y herramientas entre {allPosts.length} artículos.</p></header><ArchiveSearch /><nav aria-label="Categorías">{categories.map(category => <a href={`/categoria/${categoryToSlug(category)}/`}>{category}</a>)}</nav><div data-static-archive><h2>Todos los artículos</h2><div class="cards-grid">{posts.map(post => <PostCard {...post.data} slug={post.id} readingTime={calcReadingTime(post.body ?? '')} />)}</div><Pagination currentPage={1} totalPages={totalPages} totalPosts={allPosts.length} baseUrl="/archivo/" paginaUrl="/archivo/pagina/" /></div></section></BaseLayout><style>.cards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:24px 0 32px}.page-shell{padding-top:32px;padding-bottom:64px}nav{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0;color:var(--color-muted)}nav a{color:var(--color-link);padding:8px 0}h2{font-size:24px;margin:32px 0 16px}.intro{max-width:68ch;color:var(--color-muted);line-height:1.7}.start{padding:24px 0;border-bottom:1px solid #44445e}.start a{color:var(--color-link)}@media(max-width:900px){.cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.cards-grid{grid-template-columns:1fr}}</style>
