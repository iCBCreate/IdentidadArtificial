---
import { CATEGORY_EDITORIAL } from '../../lib/categories'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { SITE } from '../../config'
import { BLOG_CATEGORIES, categoryToSlug } from '../../lib/categories'
import { getSortedPosts, calcReadingTime } from '../../lib/posts'

export async function getStaticPaths() {
  const allPosts = await getSortedPosts()
  return BLOG_CATEGORIES.map(category => ({
    params: { categoria: categoryToSlug(category) },
    props: {
      category,
      posts: allPosts.filter(p => p.data.category === category),
    },
  }))
}

const { category, posts } = Astro.props
const { categoria } = Astro.params
const editorial = CATEGORY_EDITORIAL[category]
const starters = posts.filter(post => (editorial.featuredSlugs as readonly string[]).includes(post.id))
const canonicalURL = new URL(`/categoria/${categoria}/`, SITE.url).href

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category} — ${SITE.name}`,
  description: `Artículos sobre ${category} en Identidad Artificial. Análisis técnicos sobre IA en español con revisión experta.`,
  url: canonicalURL,
  inLanguage: 'es',
  isAccessibleForFree: true,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/sobre/`,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: `Artículos sobre ${category}`,
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: `${SITE.url}/${post.id}/`,
    })),
  },
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: category, item: canonicalURL },
  ],
}
---
<BaseLayout title={`${category} — IA en español`} description={editorial.introduction} jsonLd={[jsonLd,breadcrumbSchema]}><section class="page-shell"><nav aria-label="Ruta de navegación"><a href="/">Inicio</a><a href="/archivo/">Artículos</a><span aria-current="page">{category}</span></nav><header class="page-heading"><p class="eyebrow">Categoría</p><h1>{editorial.title}</h1><p class="intro">{editorial.introduction}</p></header>{starters.length > 0 && <section class="start"><h2>Para empezar</h2>{starters.map(post => <p><a href={`/${post.id}/`}>{post.data.title}</a></p>)}</section>}<h2>Todos los artículos · {posts.length}</h2><div class="cards-grid">{posts.map(post => <PostCard {...post.data} slug={post.id} readingTime={calcReadingTime(post.body ?? '')} />)}</div><a class="button-secondary" href="/archivo/">Todos los artículos</a></section></BaseLayout><style>.cards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:24px 0 32px}.page-shell{padding-top:32px;padding-bottom:64px}nav{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0;color:var(--color-muted)}nav a{color:var(--color-link);padding:8px 0}h2{font-size:24px;margin:32px 0 16px}.intro{max-width:68ch;color:var(--color-muted);line-height:1.7}.start{padding:24px 0;border-bottom:1px solid #44445e}.start a{color:var(--color-link)}@media(max-width:900px){.cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.cards-grid{grid-template-columns:1fr}}</style>
