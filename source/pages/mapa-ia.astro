---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import AITimeline from '../components/AITimeline.astro'
import KnowledgeGraph from '../components/KnowledgeGraph.astro'
import { KNOWLEDGE_MAP } from '../data/generated/knowledge-map'
import { SITE } from '../config'

const postCount = KNOWLEDGE_MAP.nodes.filter(n => n.type === 'post').length
const conceptCount = KNOWLEDGE_MAP.nodes.filter(n => n.type === 'concept').length
const companyCount = KNOWLEDGE_MAP.nodes.filter(n => n.type === 'company').length
const linkCount = KNOWLEDGE_MAP.links.length

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Mapa Semántico de Identidad Artificial',
  description: 'Grafo semántico generado en build-time que conecta artículos, conceptos, empresas y categorías del corpus de Identidad Artificial sobre IA generativa.',
  url: `${SITE.url}/mapa-ia/`,
  inLanguage: 'es',
  isAccessibleForFree: true,
  creator: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/sobre/`,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  keywords: ['inteligencia artificial', 'grafo semántico', 'LLM', 'modelos de lenguaje', 'mapa conceptual IA'],
  license: 'https://creativecommons.org/licenses/by/4.0/',
}
---

<BaseLayout
  title="Mapa Semántico de IA"
  description="Grafo semántico que conecta artículos, conceptos, empresas y modelos de IA generados en el sitio. Explora las relaciones entre temas de inteligencia artificial."
  image="/og/mapa-ia.png"
  jsonLd={datasetSchema}
>
  <section class="page-hero">
    <nav aria-label="Ruta de navegación"><a href="/">Inicio</a> / <span aria-current="page">Mapa IA</span></nav>
    <p class="page-eyebrow">Explorar</p>
    <h1>Mapa IA</h1>
    <p class="page-subtitle">Encuentra artículos sobre un concepto o una empresa y descubre cómo se relacionan con otros temas.</p>
  </section>
  <div class="page-body">
    <KnowledgeGraph nodes={KNOWLEDGE_MAP.nodes} links={KNOWLEDGE_MAP.links} />
    <section class="timeline-section" aria-label="Cronología de modelos"><h2>Cronología de modelos</h2><AITimeline /></section>
    <section class="graph-meta">
      <h2>Cómo se construye este mapa</h2>
      <p>Conecta {postCount} artículos con {conceptCount} conceptos y {companyCount} empresas mediante {linkCount} relaciones del contenido publicado. Las conexiones proceden de etiquetas, categorías y menciones; se regeneran al publicar el sitio. La posición gráfica es ilustrativa y no representa una medida científica. <a href="/como-funciona/">Consulta la metodología editorial</a>.</p>
    </section>
  </div>
</BaseLayout>

<style>
.page-hero {
  max-width: 1152px;
  margin: 0 auto;
  padding: 32px 20px 24px;
}

.page-eyebrow {
  color: #60A5FA;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  margin: 0 0 10px;
}

h1 {
  color: #E8E8F0;
  font-size: clamp(30px, 5vw, 48px);
  font-weight: 900;
  line-height: 1.15;
  margin-top: 10px;
}

.page-subtitle {
  display: block;
  max-width: 680px;
  color: #C8C8E0;
  font-size: 16px;
  line-height: 1.7;
  margin-top: 16px;
}

.page-body {
  max-width: 72rem;
  margin: 0 auto;
  padding: 16px 20px 48px;
}

.graph-meta {
  max-width: 680px;
  margin: 0 auto 32px;
}

.graph-meta h2 {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #C8C8E0;
  padding-bottom: 12px;
  border-bottom: 1px solid #2A2A40;
  margin-bottom: 16px;
  margin-top: 0;
}

.graph-meta p {
  color: #C8C8E0;
  font-size: 14px;
  line-height: 1.7;
  margin: 0;
}

.graph-meta strong {
  color: #E8E8F0;
}

.graph-meta a {
  color: #60A5FA;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s;
}
.graph-meta a:hover {
  border-bottom-color: #60A5FA;
}
.timeline-section { margin: 48px 0; overflow-x: auto; }
nav { color: #C8C8E0; margin-bottom: 24px; }
nav a { color: #A78BFA; }
</style>
