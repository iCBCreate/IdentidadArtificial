---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import Pagination from '../../components/Pagination.astro'
import {
  HOME_PAGE_SIZE,
  calcReadingTime,
  getPageItems,
  getSortedPosts,
  getTotalPages,
  type BlogPost,
} from '../../lib/posts'

interface Props {
  page: number
  totalPages: number
  allPosts: BlogPost[]
}

export async function getStaticPaths() {
  const allPosts = await getSortedPosts()
  const totalPages = getTotalPages(allPosts.length, HOME_PAGE_SIZE)
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, totalPages, allPosts },
  }))
}

const { page, totalPages, allPosts } = Astro.props
const posts = getPageItems(allPosts, page, HOME_PAGE_SIZE)
---
<BaseLayout title={`Artículos · Página ${page}`} description={`Artículos de IA, página ${page} de ${totalPages}.`} robots="noindex, follow"><section class="page-shell"><nav aria-label="Ruta de navegación"><a href="/">Inicio</a><a href="/archivo/">Artículos</a><span aria-current="page">Página {page}</span></nav><header class="page-heading"><h1>Artículos · Página {page}</h1><p>Página {page} de {totalPages}</p></header><div class="cards-grid">{posts.map(post => <PostCard {...post.data} slug={post.id} readingTime={calcReadingTime(post.body ?? '')} />)}</div><Pagination currentPage={page} totalPages={totalPages} totalPosts={allPosts.length} baseUrl="/" paginaUrl="/pagina/" /></section></BaseLayout><style>.cards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:24px 0 32px}.page-shell{padding-top:32px;padding-bottom:64px}nav{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0;color:var(--color-muted)}nav a{color:var(--color-link);padding:8px 0}h2{font-size:24px;margin:32px 0 16px}.intro{max-width:68ch;color:var(--color-muted);line-height:1.7}.start{padding:24px 0;border-bottom:1px solid #44445e}.start a{color:var(--color-link)}@media(max-width:900px){.cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.cards-grid{grid-template-columns:1fr}}</style>
