---
import { getEligibleTags } from '../../lib/content-policy.mjs'
import { categoryToSlug } from '../../lib/categories'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { SITE } from '../../config'
import { getSortedPosts, calcReadingTime } from '../../lib/posts'

export const prerender = true

export async function getStaticPaths() {
  const allPosts = await getSortedPosts()

  const eligible = getEligibleTags(allPosts)
  const tagMap = new Map<string, typeof allPosts>()
  for (const post of allPosts) {
    for (const tag of post.data.tags) {
      const existing = tagMap.get(tag) ?? []
      existing.push(post)
      tagMap.set(tag, existing)
    }
  }

  // Only generate strategic tag pages; eligibility keeps existing two-post exceptions.
  return [...tagMap.entries()]
    .filter(([tag]) => eligible.has(tag))
    .map(([tag, posts]) => ({
      params: { tag },
      props: { tag, posts },
    }))
}

interface Props {
  tag: string
  posts: Awaited<ReturnType<typeof getSortedPosts>>
}

const { tag, posts } = Astro.props
const canonicalURL = new URL(`/tag/${tag}/`, SITE.url).href
const categories = [...new Set(posts.map(post => post.data.category))]
const displayTag = tag.replace(/-/g, ' ')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${displayTag} — ${SITE.name}`,
  description: `Artículos etiquetados con "${displayTag}" en Identidad Artificial.`,
  url: canonicalURL,
  inLanguage: 'es',
  isAccessibleForFree: true,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/sobre/`,
  },
  mainEntity: {
    '@type': 'ItemList',
    name: `Artículos sobre ${displayTag}`,
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: post.data.title,
      url: `${SITE.url}/${post.id}/`,
    })),
  },
}
---
<BaseLayout title={`${displayTag} — IA en español`} description={`Lecturas sobre ${displayTag}: ${posts.length} artículos de Identidad Artificial.`} jsonLd={jsonLd}><section class="page-shell"><nav aria-label="Ruta de navegación"><a href="/">Inicio</a><a href="/archivo/">Artículos</a><span aria-current="page">{displayTag}</span></nav><header class="page-heading"><p class="eyebrow">Tema</p><h1>{displayTag}</h1><p class="intro">Explora {posts.length} artículos que tratan {displayTag}. Sigue las categorías para ampliar la lectura con temas relacionados.</p></header><nav aria-label="Categorías relacionadas">{categories.map(category => <a href={`/categoria/${categoryToSlug(category)}/`}>{category}</a>)}</nav><div class="cards-grid">{posts.map(post => <PostCard {...post.data} slug={post.id} readingTime={calcReadingTime(post.body ?? '')} />)}</div><a class="button-secondary" href="/archivo/">Todos los artículos</a></section></BaseLayout><style>.cards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:24px 0 32px}.page-shell{padding-top:32px;padding-bottom:64px}nav{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0;color:var(--color-muted)}nav a{color:var(--color-link);padding:8px 0}h2{font-size:24px;margin:32px 0 16px}.intro{max-width:68ch;color:var(--color-muted);line-height:1.7}.start{padding:24px 0;border-bottom:1px solid #44445e}.start a{color:var(--color-link)}@media(max-width:900px){.cards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.cards-grid{grid-template-columns:1fr}}</style>
