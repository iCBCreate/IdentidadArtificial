---
import { getCollection, render } from 'astro:content'
import { Image, getImage } from 'astro:assets'
import ReadingToc from '../../components/ReadingToc.astro'
import { getModifiedDate } from '../../lib/content-policy.mjs'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SITE } from '../../config'

export const prerender = true

export async function getStaticPaths() {
  const tutoriales = await getCollection('tutoriales')
  return tutoriales.map(tutorial => ({
    params: { slug: tutorial.id },
    props: { tutorial, tutoriales },
  }))
}

const { tutorial, tutoriales } = Astro.props
const { Content, headings } = await render(tutorial)
const prerequisites = tutorial.data.prerequisites ?? []

const next = tutoriales.filter(t => t.id !== tutorial.id).sort((a,b) => Number(b.data.herramienta === tutorial.data.herramienta) - Number(a.data.herramienta === tutorial.data.herramienta) || a.data.pubDate.valueOf() - b.data.pubDate.valueOf())[0]
const modifiedDate = getModifiedDate(tutorial.data)
const formattedDate = new Date(tutorial.data.pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const canonicalURL = new URL(`/tutoriales/${tutorial.id}/`, 'https://identidadartificial.com').href

const heroOgImage = tutorial.data.heroImage
  ? await getImage({ src: tutorial.data.heroImage, format: 'jpeg', width: 1200, height: 630, quality: 75 })
  : null

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  articleSection: 'Tutorial',
  learningResourceType: 'tutorial',
  name: tutorial.data.title,
  headline: tutorial.data.title,
  description: tutorial.data.description,
  datePublished: new Date(tutorial.data.pubDate).toISOString(),
  dateModified: getModifiedDate(tutorial.data).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: `${SITE.url}/sobre/`,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  inLanguage: 'es-ES',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Tutoriales', item: `${SITE.url}/tutoriales/` },
    { '@type': 'ListItem', position: 3, name: tutorial.data.title },
  ],
}

const jsonLd = [articleJsonLd, breadcrumbJsonLd]
---
<BaseLayout title={tutorial.data.title} description={tutorial.data.description} jsonLd={jsonLd} image={heroOgImage?.src} type="article">
<Fragment slot="head"><meta property="article:published_time" content={tutorial.data.pubDate.toISOString()} /><meta property="article:modified_time" content={modifiedDate.toISOString()} /></Fragment>
<article class="page-shell tutorial-detail"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>›</span><a href="/tutoriales/">Tutoriales</a><span>›</span><span aria-current="page">{tutorial.data.title}</span></nav><header class="page-heading reading-content"><p class="eyebrow">{tutorial.data.herramienta} · {tutorial.data.dificultad} · {tutorial.data.tiempoEstimado}</p><h1>{tutorial.data.title}</h1><p>{tutorial.data.description}</p><p class="byline">Por <a href="/sobre/" rel="author">{SITE.author}</a> · Publicado <time datetime={tutorial.data.pubDate.toISOString()}>{formattedDate}</time>{modifiedDate.valueOf() > tutorial.data.pubDate.valueOf() && <> · Actualizado <time datetime={modifiedDate.toISOString()}>{modifiedDate.toLocaleDateString('es-ES')}</time></>}</p></header>
{tutorial.data.heroImage && <Image src={tutorial.data.heroImage} alt={tutorial.data.title} width={1000} format="avif" loading="eager" class="tutorial-hero" />}

<section class="preparation reading-content"><h2>Qué conseguirás</h2><p>{tutorial.data.learningOutcome ?? tutorial.data.description}</p>{prerequisites.length > 0 && <><h2>Antes de empezar</h2><ul>{prerequisites.map(requirement => <li>{requirement}</li>)}</ul></>}</section>
<div class="reading-layout"><ReadingToc headings={headings} /><div class="reading-body"><div class="reading-content tutorial-content"><Content /></div>
<section class="final-check"><h2>Comprueba lo aprendido</h2><p>Vuelve al resultado de esta guía: {tutorial.data.learningOutcome ?? tutorial.data.description}</p><p>Si aún no lo has conseguido, utiliza el índice para repasar el apartado que necesitas.</p></section>
<details class="provenance"><summary>Cómo se preparó este tutorial</summary><p>Generado con {tutorial.data.generatedBy}. Revisión humana: {tutorial.data.humanReviewed ? 'Sí' : 'No'}.</p><p>{tutorial.data.promptBase}</p>{tutorial.data.correctionNote && <p>{tutorial.data.correctionNote}</p>}</details>
{next && <section class="next"><h2>Siguiente lectura</h2><a href={`/tutoriales/${next.id}/`}>{next.data.title}</a><p>{next.data.learningOutcome ?? next.data.description}</p></section>}<a class="button-secondary" href="/tutoriales/">Todos los tutoriales</a>
</div></div></article></BaseLayout>
<style>
.tutorial-detail{padding-top:32px;padding-bottom:64px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;font-size:14px;margin-bottom:24px;color:var(--color-muted)}a{color:var(--color-link)}.byline{font-size:14px}.tutorial-hero{max-width:820px;width:100%;height:auto;border-radius:12px;margin:24px 0}.preparation{margin:24px 0 32px;padding:24px 0;border-block:1px solid #44445e}.preparation h2,.final-check h2,.next h2{font-size:24px;margin:16px 0}.preparation ul{padding-left:24px;list-style:disc}.reading-layout{display:grid;gap:32px;min-width:0}.reading-body{max-width:68ch;min-width:0}.tutorial-content{font-size:17px;line-height:1.7;color:var(--color-muted)}.tutorial-content :global(h2){font-size:28px;font-weight:700;color:var(--color-text);margin:40px 0 16px;scroll-margin-top:100px}.tutorial-content :global(h3){font-size:22px;font-weight:600;margin:32px 0 12px;scroll-margin-top:100px}.tutorial-content :global(p){margin:16px 0;overflow-wrap:anywhere}.tutorial-content :global(a){color:var(--color-link);text-decoration:underline}.tutorial-content :global(ul){list-style:disc;padding-left:24px}.tutorial-content :global(ol){list-style:decimal;padding-left:24px}.tutorial-content :global(li){margin:8px 0}.tutorial-content :global(pre){padding:16px;max-width:100%;overflow:auto;background:var(--color-surface);border-radius:8px}.tutorial-content :global(blockquote){border-left:3px solid var(--color-link);padding-left:16px}.tutorial-content :global(table){display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;margin:24px 0;font-size:16px}.tutorial-content :global(th),.tutorial-content :global(td){padding:12px;border:1px solid #666680;text-align:left;min-width:140px}.tutorial-content :global(th){background:var(--color-surface);color:var(--color-text)}.final-check,.next,.provenance{margin:32px 0;padding-top:24px;border-top:1px solid #44445e}.provenance summary{cursor:pointer;min-height:44px}.provenance p{margin:12px 0;color:var(--color-muted)}@media(min-width:768px){.tutorial-content{font-size:18px}}@media(min-width:1200px){.reading-layout{grid-template-columns:minmax(0,1fr) 240px}.reading-body{grid-column:1;grid-row:1}}
</style>
