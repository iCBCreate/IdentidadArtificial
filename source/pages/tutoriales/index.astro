---
export const prerender = true
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { SITE } from '../../config'

const tutoriales = await getCollection('tutoriales')
const sorted = tutoriales.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const tools = [...new Set(sorted.map(t => t.data.herramienta))]
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Tutoriales de IA para Principiantes',
  description: 'Guías paso a paso para aprender a usar herramientas de IA generativa',
  url: `${SITE.url}/tutoriales/`,
  numberOfItems: sorted.length,
  itemListElement: sorted.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.data.title,
    url: `${SITE.url}/tutoriales/${t.id}/`,
  })),
}
---
<BaseLayout title="Tutoriales de IA: aprende paso a paso" description="Guías para comenzar con ChatGPT, personalizar un GPT y comprender cómo utilizan información las herramientas de IA." image="/og/tutoriales.png" jsonLd={itemListSchema}><section class="page-shell"><nav aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-current="page">Tutoriales</span></nav><header class="page-heading"><p class="eyebrow">Aprende a usar IA</p><h1>Qué quieres aprender</h1><p>Elige una guía según la tarea que necesitas resolver. Cada una indica el tiempo, la dificultad y el resultado esperado.</p></header><div class="filter" hidden><label for="tool-filter">Herramienta</label><select id="tool-filter"><option value="">Todas las herramientas</option>{tools.map(tool => <option value={tool}>{tool}</option>)}</select></div><p data-filter-status role="status" aria-live="polite">{sorted.length} tutoriales</p><div class="tutorial-grid">{sorted.map(tutorial => <article class="tutorial-card" data-tool={tutorial.data.herramienta}><p class="eyebrow">{tutorial.data.herramienta} · {tutorial.data.dificultad}</p><h2><a href={`/tutoriales/${tutorial.id}/`}>{tutorial.data.title}</a></h2><p>{tutorial.data.learningOutcome ?? tutorial.data.description}</p><span>{tutorial.data.tiempoEstimado}</span></article>)}</div></section></BaseLayout>
<script>
const filter = document.querySelector<HTMLSelectElement>('#tool-filter')!
const cards = [...document.querySelectorAll<HTMLElement>('.tutorial-card')]
document.querySelector<HTMLElement>('.filter')!.hidden = false
filter.addEventListener('change', () => { let visible = 0; for (const card of cards) {card.hidden = !!filter.value && card.dataset.tool !== filter.value; if(!card.hidden) visible++} document.querySelector('[data-filter-status]')!.textContent = `${visible} tutoriales` })
</script>
<style>.page-shell{padding-top:32px;padding-bottom:64px}nav{display:flex;gap:16px;margin-bottom:24px;color:var(--color-muted)}a{color:var(--color-link)}.filter{margin:24px 0}.filter label{display:block;margin-bottom:8px;font-weight:600}select{min-height:44px;padding:8px 12px;max-width:100%;background:var(--color-surface);border:1px solid #666680;border-radius:8px;color:var(--color-text)}.tutorial-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:24px}.tutorial-card{padding:24px;border:1px solid #44445e;border-radius:12px;background:var(--color-surface)}.tutorial-card h2{font-size:22px;line-height:1.4;margin:12px 0}.tutorial-card p{color:var(--color-muted);line-height:1.7}.tutorial-card span{display:block;margin-top:16px;font-size:14px;color:var(--color-muted)}@media(max-width:650px){.tutorial-grid{grid-template-columns:1fr}}</style>
